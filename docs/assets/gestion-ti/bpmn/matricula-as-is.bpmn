<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MatriculaAsIs" targetNamespace="https://academia-school-platform.vercel.app/bpmn" exporter="generar-bpmn.mjs (Plataforma CERMAT)" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_MatriculaAsIs">
    <bpmn:participant id="Participant_AcademiaAsIs" name="Academia La Prepa Cermat: matrícula (AS-IS, proceso manual)" processRef="Process_MatriculaAsIs" />
    <bpmn:textAnnotation id="Note_Redigitacion">
      <bpmn:text>Re-digitación en cuaderno, hojas y listas; sin control de duplicados</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Cupo">
      <bpmn:text>Cupo en otro registro: riesgo de sobrecupo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Espera">
      <bpmn:text>Espera de 1 a 3 días por la autorización presencial (supuesto)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Pago">
      <bpmn:text>Pago desconectado de la matrícula: conciliación manual</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Confirmacion">
      <bpmn:text>Confirmación verbal: sin acceso para el alumno ni código para el padre</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Redigitacion" associationDirection="None" sourceRef="Task_A2_Registrar" targetRef="Note_Redigitacion" />
    <bpmn:association id="Assoc_Note_Cupo" associationDirection="None" sourceRef="Task_A3_VerificarCupo" targetRef="Note_Cupo" />
    <bpmn:association id="Assoc_Note_Espera" associationDirection="None" sourceRef="Task_A4_Autorizar" targetRef="Note_Espera" />
    <bpmn:association id="Assoc_Note_Pago" associationDirection="None" sourceRef="Task_A6_Conciliar" targetRef="Note_Pago" />
    <bpmn:association id="Assoc_Note_Confirmacion" associationDirection="None" sourceRef="Task_A7_Confirmar" targetRef="Note_Confirmacion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_MatriculaAsIs" name="Matrícula AS-IS" isExecutable="false">
    <bpmn:documentation>Proceso de matrícula manual de la Academia La Prepa Cermat. Tiempos de personal por actividad: supuestos a validar con 10 trámites cronometrados (E4, sección 4.3.4). Total: 40 min (35 de secretaría y 5 de la Dirección). Equipo EPE CERMAT, 2026-10-24.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_MatriculaAsIs">
      <bpmn:lane id="Lane_Padre" name="Padre o postulante">
        <bpmn:flowNodeRef>Start_Interes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P1_Consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_P2_Pagar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Matriculado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaria" name="Secretaría">
        <bpmn:flowNodeRef>Task_A1_Informar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A2_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A3_VerificarCupo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HayCupo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A3B_OfrecerOtro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoConcretada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A5_Cobrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A6_Conciliar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A7_Confirmar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direccion" name="Dirección">
        <bpmn:flowNodeRef>Task_A4_Autorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Autoriza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Interes" name="Interés en matricular">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_P1_Consultar" name="Consultar en persona, por teléfono o WhatsApp">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_A1_Informar" name="A1 Informar oferta, horarios y precios (10 min)">
      <bpmn:documentation>Supuesto: 10 min de secretaría.</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_A2_Registrar" name="A2 Registrar datos en cuaderno u hoja (6 min)">
      <bpmn:documentation>Supuesto: 6 min. Problema: re-digitación y duplicados.</bpmn:documentation>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_A3_VerificarCupo" name="A3 Verificar cupo en otra lista (4 min)">
      <bpmn:documentation>Supuesto: 4 min. Problema: el cupo vive en un registro distinto al de la matrícula.</bpmn:documentation>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_HayCupo" name="¿Hay cupo?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06_NoCupo</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_SiCupo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_A3B_OfrecerOtro" name="Ofrecer otro grupo o lista de espera">
      <bpmn:incoming>Flow_06_NoCupo</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_NoConcretada" name="Matrícula no concretada">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Task_A4_Autorizar" name="A4 Revisar y autorizar en persona (5 min)">
      <bpmn:documentation>Supuesto: 5 min de la Dirección. Problema: espera de 1 a 3 días si no está disponible.</bpmn:documentation>
      <bpmn:incoming>Flow_08_SiCupo</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_Autoriza" name="¿Autoriza?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10_NoAutoriza</bpmn:outgoing>
      <bpmn:outgoing>Flow_11_SiAutoriza</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rechazada" name="Matrícula rechazada">
      <bpmn:incoming>Flow_10_NoAutoriza</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Task_P2_Pagar" name="Pagar en efectivo">
      <bpmn:incoming>Flow_11_SiAutoriza</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_A5_Cobrar" name="A5 Cobrar y emitir recibo físico (6 min)">
      <bpmn:documentation>Supuesto: 6 min.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_A6_Conciliar" name="A6 Conciliar el pago con el registro (3 min)">
      <bpmn:documentation>Supuesto: 3 min. Problema: pago desconectado de la matrícula.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_A7_Confirmar" name="A7 Confirmar al padre y agregar a la lista (6 min)">
      <bpmn:documentation>Supuesto: 6 min. Problema: confirmación verbal, sin acceso digital.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_Matriculado" name="Matriculado sin confirmación digital">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Interes" targetRef="Task_P1_Consultar" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_P1_Consultar" targetRef="Task_A1_Informar" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_A1_Informar" targetRef="Task_A2_Registrar" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_A2_Registrar" targetRef="Task_A3_VerificarCupo" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_A3_VerificarCupo" targetRef="Gateway_HayCupo" />
    <bpmn:sequenceFlow id="Flow_06_NoCupo" name="No" sourceRef="Gateway_HayCupo" targetRef="Task_A3B_OfrecerOtro" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_A3B_OfrecerOtro" targetRef="End_NoConcretada" />
    <bpmn:sequenceFlow id="Flow_08_SiCupo" name="Sí" sourceRef="Gateway_HayCupo" targetRef="Task_A4_Autorizar" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_A4_Autorizar" targetRef="Gateway_Autoriza" />
    <bpmn:sequenceFlow id="Flow_10_NoAutoriza" name="No" sourceRef="Gateway_Autoriza" targetRef="End_Rechazada" />
    <bpmn:sequenceFlow id="Flow_11_SiAutoriza" name="Sí" sourceRef="Gateway_Autoriza" targetRef="Task_P2_Pagar" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_P2_Pagar" targetRef="Task_A5_Cobrar" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_A5_Cobrar" targetRef="Task_A6_Conciliar" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_A6_Conciliar" targetRef="Task_A7_Confirmar" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_A7_Confirmar" targetRef="End_Matriculado" />
  </bpmn:process>
