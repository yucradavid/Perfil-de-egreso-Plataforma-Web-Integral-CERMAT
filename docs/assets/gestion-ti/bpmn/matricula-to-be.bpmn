      <bpmndi:BPMNShape id="Lane_Postulante_di" bpmnElement="Lane_Postulante" isHorizontal="true">
        <dc:Bounds x="190" y="160" width="2150" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Plataforma_di" bpmnElement="Lane_Plataforma" isHorizontal="true">
        <dc:Bounds x="190" y="310" width="2150" height="150" />
      </bpmndi:BPMNShape>
