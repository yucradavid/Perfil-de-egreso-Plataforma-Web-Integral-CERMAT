        <bpmndi:BPMNLabel>
          <dc:Bounds x="2020" y="789" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Transaccion_di" bpmnElement="Note_Transaccion">
        <dc:Bounds x="635" y="56" width="190" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Invitacion_di" bpmnElement="Note_Invitacion">
        <dc:Bounds x="1535" y="56" width="190" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Conciliacion_di" bpmnElement="Note_Conciliacion">
        <dc:Bounds x="1835" y="880" width="190" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="298" y="235" />
        <di:waypoint x="370" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="490" y="235" />
        <di:waypoint x="580" y="235" />
        <di:waypoint x="580" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="298" y="535" />
        <di:waypoint x="370" y="535" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="490" y="535" />
        <di:waypoint x="580" y="535" />
        <di:waypoint x="580" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="605" y="385" />
        <di:waypoint x="670" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="790" y="385" />
        <di:waypoint x="855" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_NoValida_di" bpmnElement="Flow_07_NoValida">
