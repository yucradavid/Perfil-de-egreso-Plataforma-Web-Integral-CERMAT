          <dc:Bounds x="1725" y="326" width="110" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_T5_EnviarEnlace_di" bpmnElement="Task_T5_EnviarEnlace">
        <dc:Bounds x="1870" y="495" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_T8_Activar_di" bpmnElement="Task_T8_Activar">
        <dc:Bounds x="2020" y="195" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Activo_di" bpmnElement="End_Activo">
