        <mxCell id="tot" value="Totales&lt;br&gt;14 vCPU sobre 16 hilos (0,88:1)&lt;br&gt;24 GB de VM + 6 GB de sistema = 30 GB de 64 GB (47 %)&lt;br&gt;344 GB de disco de VM (38 % del espejo)&lt;br&gt;Orden de arranque: VM-FW01 → VM-BAS01 → VM-SIEM01 → VM-APP01 → demás" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;rounded=1;fillColor=#ffffff;strokeColor=#bfbfbf;" vertex="1" parent="1">
